option ClientOutput = "C:\Users\PC\Documents\CubitWorldDevCursor\src\shared\Blink\network_client.luau"
option ServerOutput = "C:\Users\PC\Documents\CubitWorldDevCursor\src\shared\Blink\network_server.luau"

-- ==========================================
-- STRUKTURY (Structures)
-- ==========================================

struct SettingsUpdate {
    FOV: u8?,
    MusicVol: u8?,
    ShowFPS: boolean?,
    GlobalShadows: boolean
}

struct CurrencySyncData {
    currencyType: string,
    value: f64
}

struct EggBuyRequest {
    eggName: string
}

struct EggHatchedData {
    petName: string
}

struct EggSyncData {
    eggName: string,
    amount: u32
}

struct PetSyncData {
    uuid: string,
    petName: string,
    level: u16,
    isRemoved: boolean?
}

struct EquippedPetInfo {
    uuid: string,
    petName: string
}

-- ==========================================
-- EVENTY (Events)
-- ==========================================

event UpdateSettings {
    From: Client,
    Type: Reliable,
    Call: SingleAsync,
    Data: SettingsUpdate
}

event SyncSettings {
    From: Server,
    Type: Reliable,
    Call: SingleSync,
    Data: SettingsUpdate
}

event SyncRegion {
    From: Server,
    Type: Reliable,
    Call: SingleSync,
    Data: string
}

event SyncCurrency {
    From: Server,
    Type: Reliable,
    Call: SingleSync,
    Data: CurrencySyncData
}

event RequestBuyEgg {
    From: Client,
    Type: Reliable,
    Call: SingleAsync,
    Data: EggBuyRequest
}

event EggHatched {
    From: Server,
    Type: Reliable,
    Call: SingleSync,
    Data: EggHatchedData
}

event SyncEggs {
    From: Server,
    Type: Reliable,
    Call: SingleSync,
    Data: EggSyncData
}

event RequestHatch {
    From: Client,
    Type: Reliable,
    Call: SingleAsync,
    Data: struct {
        eggName: string,
        amount: u8
    }
}

event SyncPets {
    From: Server,
    Type: Reliable,
    Call: SingleAsync,
    Data: PetSyncData
}

event RequestEquip {
    From: Client,
    Type: Reliable,
    Call: SingleSync,
    Data: struct {
        uuid: string
    }
}

event SyncEquippedPets {
    From: Server,
    Type: Reliable,
    Call: SingleSync,
    Data: struct {
        userId: f64,
        equippedPets: EquippedPetInfo[]
    }
}

-- NOWY EVENT
event RequestInitialSync {
    From: Client,
    Type: Reliable,
    Call: SingleAsync
}