option ClientOutput = "C:\Users\PC\Desktop\BlinkSetup\network_client.luau"
option ServerOutput = "C:\Users\PC\Desktop\BlinkSetup\network_server.luau"

struct SettingsUpdate {
    FOV: u8?,
    MusicVol: u8?,
    ShowFPS: boolean?,
    GlobalShadows: boolean?
}

event UpdateSettings {
    From: Client,
    Type: Reliable,
    Call: SingleAsync,
    Data: SettingsUpdate
}

event SyncSettings {
    From: Server,
    Type: Reliable,
    Call: SingleSync,
    Data: SettingsUpdate
}

event SyncRegion {
    From: Server,
    Type: Reliable,
    Call: SingleSync,
    Data: string
}